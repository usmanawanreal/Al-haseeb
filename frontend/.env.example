# Copy to .env.local for local dev (Vite loads VITE_* automatically)

# Backend API base URL (must include /api)
VITE_API_URL=http://localhost:5000/api

# Production (set in Vercel → Project → Settings → Environment Variables):
# VITE_API_URL=https://your-backend-project.vercel.app/api
#
# Admin panel: same frontend app at /login (admin account) then /admin
# Backend must have ADMIN_EMAIL, ADMIN_PASSWORD, JWT_SECRET, FRONTEND_URL, MONGO_URI
