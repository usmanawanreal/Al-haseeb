# Copy to .env and adjust values

MONGO_URI=mongodb://localhost:27017/alhaseeb

# Optional: one-time copy source (MONGO_URI) → destination (use with npm run db:copy)
# COPY_URI=mongodb://localhost:27017/alhaseeb_backup
# COPY_CONFIRM=yes
# COPY_DRY_RUN=1

JWT_SECRET=change_this_to_a_long_random_string
PORT=5000

# Comma-separated frontend URL(s) for CORS (required in production on Vercel)
# Example: https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin — created/synced on API startup (required on Vercel for /admin login)
# Use the same email/password on https://your-frontend.vercel.app/login → redirects to /admin
ADMIN_EMAIL=ua8241@gmail.com
ADMIN_PASSWORD=your_secure_admin_password
# Set ADMIN_FORCE_SYNC=true only to reset admin password from env on next deploy
# ADMIN_FORCE_SYNC=true

# Optional: inbox(es) for new online bookings (comma-separated). Defaults to ADMIN_EMAIL when unset.
# ADMIN_NOTIFY_EMAIL=ops@yourclinic.com,manager@yourclinic.com

# Optional display name for the admin user
# ADMIN_FULL_NAME=Administrator

# Email notifications — SMTP required for forgot-password OTP and booking emails (Gmail: App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your@gmail.com

# Optional SMS via Twilio (Pakistan numbers supported)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
